# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider selection (server-only — never expose as NEXT_PUBLIC_*)
# AI_PROVIDER=openai
# AI_PROVIDER=gemini
AI_PROVIDER=openai

# OpenAI (when AI_PROVIDER=openai, or as AI_FALLBACK_PROVIDER=openai)
AI_PROVIDER_API_KEY=
# AI_CHAT_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# Google Gemini (when AI_PROVIDER=gemini, or as AI_FALLBACK_PROVIDER=gemini)
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional explicit fallback — only used when primary provider fails
# AI_FALLBACK_PROVIDER=openai

# AI_REQUEST_TIMEOUT_MS=45000
# AI_VISION_TIMEOUT_MS=60000

# Optional — used automatically by Next.js
# NODE_ENV=development
